# Angel One SmartAPI credentials — copy this file to ".env.local" and fill real values.
# .env.local is gitignored and NEVER pushed to GitHub.
# On Vercel, add these same keys under: Project > Settings > Environment Variables.
# These are read ONLY on the server (API routes); they never reach the browser.

# From your SmartAPI app (smartapi.angelbroking.com > My Apps):
SMARTAPI_API_KEY=
SMARTAPI_API_SECRET=

# Your Angel One login:
SMARTAPI_CLIENT_CODE=
SMARTAPI_MPIN=

# TOTP secret (the base32 string shown when you enable TOTP / scan the QR in Angel One).
# Needed so the server can auto-generate the 6-digit code at login.
SMARTAPI_TOTP_SECRET=

# Google Gemini API key — for data NOT in SmartAPI (FII/DII, news, public data),
# via Gemini with Google Search grounding. Get it from aistudio.google.com/apikey
GEMINI_API_KEY=
