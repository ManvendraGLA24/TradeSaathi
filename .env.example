# Server credentials — use a private .env.local locally and fill real values.
# .env.local is gitignored and NEVER pushed to GitHub.
# A persistent Node host is required for the /stream WebSocket endpoint.
# These are read ONLY on the server; they never reach the browser.
# There is no login on this dashboard — anyone with the URL can view it.

# From your SmartAPI app (smartapi.angelbroking.com > My Apps):
SMARTAPI_API_KEY=
SMARTAPI_API_SECRET=

# Your Angel One login:
SMARTAPI_CLIENT_CODE=
SMARTAPI_MPIN=

# TOTP secret (the base32 string shown when you enable TOTP / scan the QR in Angel One).
# Needed so the server can auto-generate the 6-digit code at login.
SMARTAPI_TOTP_SECRET=

# Google Gemini API key — used on demand for grounded market commentary.
# Gemini is not a quote feed. Get a key from aistudio.google.com/apikey.
GEMINI_API_KEY=
